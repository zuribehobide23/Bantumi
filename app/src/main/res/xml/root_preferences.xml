<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/messages_header">

        <EditTextPreference
            app:key="prefKeyNombreJugador"
            app:title="@string/signature_title"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="Jugador 1" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefTituloCategoria2">

        <ListPreference
            app:key="prefKeyNumInicialSemillas"
            app:title="@string/prefTituloNumInicialSemillas"
            app:summary="%s"
            app:defaultValue="4"
            app:entries="@array/num_semillas_entries"
            app:entryValues="@array/num_semillas_values" />

    </PreferenceCategory>

</PreferenceScreen>
