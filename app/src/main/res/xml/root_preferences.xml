<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/messages_header">

        <EditTextPreference
            app:key="prefKeyNombreJugador"
            app:title="@string/signature_title"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="Jugador 1" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefTituloCategoria2">

        <EditTextPreference
            app:key="prefKeyNumInicialSemillas"
            app:title="@string/prefTituloNumInicialSemillas"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="4" />

        <ListPreference
            app:key="prefKeyTurnoInicial"
            app:title="@string/prefTituloTurnoInicial"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="turnoJ1"
            app:entries="@array/turno_entries"
            app:entryValues="@array/turno_values" />

    </PreferenceCategory>

</PreferenceScreen>
