<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/messages_header">

        <EditTextPreference
            app:key="prefKeyNombreJugador"
            app:title="@string/signature_title"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="Jugador 1" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefTituloCategoria2">

        <EditTextPreference
            app:key="prefKeyNumInicialSemillas"
            app:title="@string/prefTituloNumInicialSemillas"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="4" />

        <ListPreference
            app:key="prefKeyTurnoInicial"
            app:title="@string/prefTituloTurnoInicial"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="turnoJ1"
            app:entries="@array/turno_entries"
            app:entryValues="@array/turno_values" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefTituloApariencia">

        <ListPreference
            app:key="prefKeyColorTema"
            app:title="@string/prefTituloColorTema"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="azul"
            app:entries="@array/color_entries"
            app:entryValues="@array/color_values" />

        <ListPreference
            app:key="prefKeyIdioma"
            app:title="@string/prefTituloIdioma"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="es"
            app:entries="@array/idioma_entries"
            app:entryValues="@array/idioma_values" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefTituloPersonalizacionColores">

        <ListPreference
            app:key="prefKeyColorFondoJuego"
            app:title="@string/prefColorFondoJuego"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="blanco"
            app:entries="@array/color_personalizado_entries"
            app:entryValues="@array/color_personalizado_values" />

        <ListPreference
            app:key="prefKeyColorCasillas"
            app:title="@string/prefColorCasillas"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="gris"
            app:entries="@array/color_personalizado_entries"
            app:entryValues="@array/color_personalizado_values" />

        <ListPreference
            app:key="prefKeyColorSemillas"
            app:title="@string/prefColorSemillas"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="negro"
            app:entries="@array/color_personalizado_entries"
            app:entryValues="@array/color_personalizado_values" />

        <ListPreference
            app:key="prefKeyColorNombreJugador"
            app:title="@string/prefColorNombreJugador"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="negro"
            app:entries="@array/color_personalizado_entries"
            app:entryValues="@array/color_personalizado_values" />

        <ListPreference
            app:key="prefKeyColorTurnoFondo"
            app:title="@string/prefColorTurnoFondo"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="azul"
            app:entries="@array/color_personalizado_entries"
            app:entryValues="@array/color_personalizado_values" />

        <ListPreference
            app:key="prefKeyColorIconos"
            app:title="@string/prefColorIconos"
            app:summary="%s"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="azul"
            app:entries="@array/color_personalizado_entries"
            app:entryValues="@array/color_personalizado_values" />

    </PreferenceCategory>

</PreferenceScreen>
